<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.bookreviewapp.ui.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_resultFragment"
            app:destination="@id/resultFragment" />
        <action
            android:id="@+id/action_homeFragment_to_bookDetailsFragment"
            app:destination="@id/bookDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_subjectFragment"
            app:destination="@id/subjectFragment" />
        <action
            android:id="@+id/action_homeFragment_to_myReviewsFragment"
            app:destination="@id/myReviewsFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.example.bookreviewapp.ui.fragments.ResultFragment"
        android:label="Results"
        tools:layout="@layout/result_fragment">
        <argument
            android:name="query"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/bookDetailsFragment"
        android:name="com.example.bookreviewapp.ui.fragments.BookDetailsFragment"
        android:label="Book Details"
        tools:layout="@layout/fragment_book_details">
        <argument
            android:name="bookId"
            app:argType="string"
            />
    </fragment>

    <fragment
        android:id="@+id/subjectFragment"
        android:name="com.example.bookreviewapp.ui.fragments.SubjectFragment"
        android:label="Subject"
        tools:layout="@layout/fragment_subject">

        <action
            android:id="@+id/action_subjectFragment_to_bookDetailsFragment"
            app:destination="@id/bookDetailsFragment" />

    </fragment>

    <fragment
        android:id="@+id/myReviewsFragment"
        android:name="com.example.bookreviewapp.ui.fragments.MyReviewsFragment"
        android:label="My Reviews">
        <action
            android:id="@+id/action_homeFragment_to_myReviewsFragment"
            app:destination="@id/myReviewsFragment" />
    </fragment>





    <!--    <fragment-->
<!--        android:id="@+id/favoriteFragment"-->
<!--        android:name="com.example.bookreviewapp.ui.FavoriteFragment"-->
<!--        android:label="Favorites"/>-->

</navigation>